<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="background" prefHeight="500.0" prefWidth="800.0" stylesheets="@../css/StylesheetName.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.view.controller.NameController">
   <Label fx:id="insertName" alignment="CENTER" layoutX="17.0" layoutY="68.0" prefHeight="80.0" prefWidth="767.0" text="Insert Name">
      <font>
         <Font size="54.0" />
      </font>
   </Label>
   <TextField fx:id="getName" layoutX="282.0" layoutY="217.0" prefHeight="25.0" prefWidth="236.0" promptText="NAME (1 to 8 alphabetical characters)..." AnchorPane.leftAnchor="282.0" AnchorPane.rightAnchor="282.0" />
   <Button fx:id="submit" disable="true" layoutX="347.0" layoutY="336.0" mnemonicParsing="false" onAction="#submit" text="submit">
      <font>
         <Font size="20.0" />
      </font>
   </Button>
   <Label fx:id="error" alignment="CENTER" layoutX="350.0" layoutY="250.0" prefHeight="33.0" prefWidth="106.0" text="Name already taken" textFill="RED" visible="false" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
      <font>
         <Font size="16.0" />
      </font></Label>
</AnchorPane>
