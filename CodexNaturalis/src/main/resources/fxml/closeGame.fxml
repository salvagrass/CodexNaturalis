<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="background" prefHeight="100.0" prefWidth="200.0" stylesheets="@../css/closeGame.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.view.controller.ConfirmQuitController">
   <Label id="title" alignment="CENTER" layoutX="-1.0" layoutY="14.0" prefHeight="34.0" prefWidth="200.0" text="Are you sure?">
      <font>
         <Font size="23.0" />
      </font>
   </Label>
   <Button id="confirm" layoutX="39.0" layoutY="64.0" mnemonicParsing="false" onAction="#confirmAction" text="Confirm" />
   <Button id="back" layoutX="107.0" layoutY="64.0" mnemonicParsing="false" onAction="#cancelAction" prefWidth="53.5" text="Back" />
</AnchorPane>
