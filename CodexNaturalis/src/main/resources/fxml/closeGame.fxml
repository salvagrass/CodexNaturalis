<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="100.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.polimi.ingsw.view.controller.ConfirmQuitController">
   <Label layoutX="26.0" layoutY="14.0" prefHeight="34.0" prefWidth="147.0" text="Are you sure?">
      <font>
         <Font size="23.0"/>
      </font>
   </Label>
   <Button layoutX="26.0" layoutY="62.0" mnemonicParsing="false" onAction="#confirmAction" text="CONFIRM"/>
   <Button layoutX="103.0" layoutY="62.0" mnemonicParsing="false" onAction="#cancelAction" prefHeight="25.0"
           prefWidth="69.0" text="BACK"/>
</AnchorPane>
