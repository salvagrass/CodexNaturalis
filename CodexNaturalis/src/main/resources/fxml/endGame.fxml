<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.view.controller.EndGameController">
   <children>
      <Label fx:id="message" layoutX="179.0" layoutY="29.0" text="MESSAGE" textAlignment="CENTER">
         <font>
            <Font size="56.0" />
         </font>
      </Label>
      <VBox fx:id="leaderboard" alignment="CENTER" layoutX="250.0" layoutY="125.0" spacing="15.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding></VBox>
      <Button fx:id="submit" layoutX="283.0" layoutY="349.0" mnemonicParsing="false" onAction="#changePhase" text="OK" />
   </children>
</AnchorPane>
