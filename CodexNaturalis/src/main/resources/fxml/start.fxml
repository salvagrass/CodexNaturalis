<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="back" prefHeight="500.0" prefWidth="800.0" stylesheets="@../css/StylesheetStart.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.view.controller.StartController">
   <Button fx:id="connect" disable="true" layoutX="346.0" layoutY="325.0" mnemonicParsing="false" onAction="#connect" text="connect">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor></Button>
   <TextField fx:id="address" alignment="CENTER" layoutX="303.0" layoutY="250.0" text="localhost" />
   <Label fx:id="error" layoutX="350.0" layoutY="305.0" text="CAN'T CONNECT" textFill="RED" visible="false" />
   <RadioButton id="rmi" layoutX="433.0" layoutY="285.0" mnemonicParsing="false" text="RMI" AnchorPane.rightAnchor="322.0">
      <toggleGroup>
         <ToggleGroup fx:id="connection" />
      </toggleGroup>
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor>
   </RadioButton>
   <RadioButton id="socket" layoutX="319.0" layoutY="285.0" mnemonicParsing="false" text="Socket" toggleGroup="$connection">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor></RadioButton>
   <ImageView fitHeight="162.0" fitWidth="200.0" layoutX="301.0" layoutY="60.0">
      <image>
         <Image url="@../graphics/Icons_Game_Title_icon.png" />
      </image>
   </ImageView>
</AnchorPane>
