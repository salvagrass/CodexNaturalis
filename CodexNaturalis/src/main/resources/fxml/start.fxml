<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="back" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.view.controller.StartController">
   <Label layoutX="286.0" layoutY="192.0" text="start" />
   <Button fx:id="connect" disable="true" layoutX="271.0" layoutY="309.0" mnemonicParsing="false" onAction="#connect" text="connect" />
   <TextField fx:id="address" layoutX="226.0" layoutY="229.0" text="localhost" />
   <Label fx:id="error" layoutX="252.0" layoutY="264.0" text="CAN'T CONNECT" textFill="RED" visible="false" />
   <RadioButton layoutX="343.0" layoutY="356.0" mnemonicParsing="false" text="RMI">
      <toggleGroup>
         <ToggleGroup fx:id="connection" />
      </toggleGroup>
   </RadioButton>
   <RadioButton layoutX="229.0" layoutY="356.0" mnemonicParsing="false" text="Socket" toggleGroup="$connection" />
</AnchorPane>
