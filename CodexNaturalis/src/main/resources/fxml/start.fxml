<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="back" prefHeight="500.0" prefWidth="800.0" stylesheets="@../css/StylesheetStart.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.view.controller.StartController">
   <Label fx:id="start" alignment="CENTER" layoutX="200.0" layoutY="64.0" prefHeight="57.0" prefWidth="565.0" text="Start" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0" />
   <Button fx:id="connect" disable="true" layoutX="346.0" layoutY="325.0" mnemonicParsing="false" onAction="#connect" text="connect">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor></Button>
   <TextField fx:id="address" alignment="CENTER" layoutX="320.0" layoutY="169.0" text="localhost" />
   <Label fx:id="error" layoutX="350.0" layoutY="205.0" text="CAN'T CONNECT" textFill="RED" visible="false" />
   <RadioButton layoutX="435.0" layoutY="231.0" mnemonicParsing="false" text="RMI" AnchorPane.rightAnchor="320.0">
      <toggleGroup>
         <ToggleGroup fx:id="connection" />
      </toggleGroup>
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor>
   </RadioButton>
   <RadioButton layoutX="322.0" layoutY="231.0" mnemonicParsing="false" text="Socket" toggleGroup="$connection">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor></RadioButton>
</AnchorPane>
