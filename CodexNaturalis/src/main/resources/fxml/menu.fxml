   <Button fx:id="joinButton" layoutX="346.0" layoutY="203.0" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#join" prefHeight="30.0" prefWidth="109.0" text="Join">
