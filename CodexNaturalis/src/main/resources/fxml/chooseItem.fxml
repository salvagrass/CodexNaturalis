<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="background" prefHeight="500.0" prefWidth="800.0" stylesheets="@../css/chooseItem.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.view.controller.ChooseItemController">
   <children>
      <ImageView fitHeight="253.0" fitWidth="206.0" layoutX="305.0" layoutY="122.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../graphics/Icons_Game_ObjectiveMan_icon.png" />
         </image>
      </ImageView>
      <Label fx:id="title" alignment="CENTER" layoutX="31.0" layoutY="57.0" prefHeight="51.0" prefWidth="735.0" stylesheets="@../css/chooseItem.css" text="Choose Item">
         <font>
            <Font size="56.0" />
         </font>
      </Label>
      <ToggleButton id="b0" layoutX="75.0" layoutY="197.0" mnemonicParsing="false">
         <graphic>
            <ImageView fx:id="img0" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
         </graphic>
         <toggleGroup>
            <ToggleGroup fx:id="items" />
         </toggleGroup>
      </ToggleButton>
      <ToggleButton id="b1" layoutX="514.0" layoutY="197.0" mnemonicParsing="false" toggleGroup="$items">
         <graphic>
            <ImageView fx:id="img1" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
         </graphic>
      </ToggleButton>
      <Button fx:id="submit" alignment="CENTER" disable="true" layoutX="350.0" layoutY="404.0" mnemonicParsing="false" onAction="#submit" stylesheets="@../css/chooseItem.css" text="Confirm">
         <font>
            <Font size="21.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
